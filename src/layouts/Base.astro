---
import '../styles/global.css';
import { SITE, SOCIALS, SECTIONS } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Skip the masthead/footer chrome and render only the slot content. */
  bare?: boolean;
}

const { title, description = SITE.description, bare = false } = Astro.props;
// The full-name form (SITE.fullName, not the lowercase-stylized SITE.name
// used everywhere on-page) here on purpose — this is what search engines
// actually display and match against a name search, unlike the visual
// wordmark elsewhere on the site.
const pageTitle = title ? `${title} / ${SITE.fullName}` : `${SITE.fullName} — ${SITE.role}`;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) =>
  (href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL('/og-image.jpg', SITE.url).toString();

const links = [...SECTIONS.map((s) => ({ href: `/${s.id}`, label: s.label })), { href: '/about', label: 'about' }];

// Person structured data (schema.org/JSON-LD) — the single strongest
// on-page signal for "this domain belongs to this specific person" in a
// name search: sameAs ties this URL to the social profiles that already
// rank, which is what search engines use to build a knowledge panel
// rather than just trusting page text. Repeated on every page (cheap, a
// few hundred bytes) rather than just the homepage, since any page could
// be the one that actually gets indexed/shown first.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.fullName,
  alternateName: [SITE.name, ...SITE.alternateNames],
  url: SITE.url,
  image: ogImageUrl,
  email: `mailto:${SITE.email}`,
  jobTitle: SITE.jobTitle,
  description: SITE.personDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.address.locality,
    addressCountry: SITE.address.country,
  },
  // The youtube entry in SOCIALS links to one specific video, not a
  // channel/profile — not something sameAs should claim represents this
  // person, unlike the rest of SOCIALS.
  sameAs: SOCIALS.filter((s) => s.label !== 'youtube').map((s) => s.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bitcount+Prop+Single:wght@100..900&display=swap"
    />
    {
      bare && (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..600&display=swap"
        />
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>

  <body>
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a class="skip" href="#main">skip to content</a>

          <div class="shell">
            <header class="masthead">
              <a class="masthead__name" href="/">{SITE.name}</a>
              <nav aria-label="sections">
                {
                  links.map((l, i) => (
                    <>
                      {i > 0 && <span aria-hidden="true">/</span>}
                      <a href={l.href} aria-current={current(l.href)}>
                        {l.label}
                      </a>
                    </>
                  ))
                }
              </nav>
            </header>

            <main id="main">
              <slot />
            </main>

            <footer class="colophon">
              <span>{SITE.name} <span class="aside">(all rights reserved)</span></span>
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            </footer>
          </div>
        </>
      )
    }
  </body>
</html>
