---
import Hub from '../../components/Hub.astro';

// Real source folder uses a literal space (public/images/proyectos/audiovisual/eliangel/mi vibe),
// not the underscore the id-derived slug (mi_vibe) would produce.
---

<Hub
  entryId="eliangel"
  folder="audiovisual/eliangel"
  initialPieceId="eliangel-mi-vibe"
  folderOverrides={{ 'eliangel-mi-vibe': 'mi vibe' }}
/>
