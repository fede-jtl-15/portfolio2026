---
import { getCollection } from 'astro:content';
import CategoryIndex, { type CategoryEntry } from '../components/CategoryIndex.astro';
import { getStripImages } from '../lib/strip-images';

// Auto-generated from the content collection — a hub's own root entry or a
// standalone piece (never a sub-piece, which has `hub` set) whose `folder`
// starts with "live/", ordered by `order`. Adding a new piece here is just
// a matter of giving its content entry a folder under live/ — see
// src/pages/work/[id].astro and content.config.ts.
const work = await getCollection('work', ({ data }) => !data.draft);
const projects = work
  .filter((e) => !e.data.hub && e.data.folder?.startsWith('live/'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((e) => ({ label: e.data.label ?? e.data.title, href: `/work/${e.id}` }));

// getStripImages() matches each source file to a work entry by filename
// (see findWorkMatch in src/lib/strip-images.ts), which fails for a couple
// of these — the source photo is named after the old id or the blurb, not
// the current one. Mapped by hand instead of trusting that match, so they
// aren't silently dropped.
const LIVE_FILE_HREF: Record<string, string> = {
  hologramas: '/work/hologramas',
  late_night_ambient: '/work/late-night-ambient',
  techno_para_dos_warp: '/work/techno-para-dos-warp',
  scenes_from_a_memory: '/work/scenes-from-a-memory',
  transit_cadence: '/work/transit-cadence',
  mutek: '/work/mutek',
  visual_jockey: '/work/visual-jockey',
};

const allStrip = await getStripImages();
const liveImages = allStrip.filter((img) => img.src.includes('/cache/live-'));
const imageByHref = new Map<string, (typeof liveImages)[number]>();
for (const img of liveImages) {
  const base = img.src.match(/\/cache\/live-(.+)\.jpg$/)?.[1] ?? '';
  const href = base.startsWith('reflected_radio') ? '/work/reflected-radio' : LIVE_FILE_HREF[base];
  if (!href || imageByHref.has(href)) continue; // one representative image per project is enough here
  imageByHref.set(href, img);
}

const entries: CategoryEntry[] = projects.map((p) => ({ ...p, image: imageByHref.get(p.href) }));
---

<CategoryIndex
  title="live"
  kicker="live visuals"
  currentHref="/live"
  entries={entries}
  description="Federico Torres — live audiovisual sets, radio broadcasts, and durational performance work."
/>
