---
interface Item {
  kind: 'vimeo' | 'youtube' | 'soundcloud' | 'bandcamp' | 'audio' | 'image';
  src: string;
  title?: string;
  caption?: string;
  alt?: string;
  track?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;

const scUrl = (src: string) =>
  `https://w.soundcloud.com/player/?url=${encodeURIComponent(src)}` +
  '&color=%231b3bd4&inverse=false&auto_play=false&show_user=true&visual=false';
---

{
  items.length > 0 && (
    <div class="media">
      {items.map((m) => (
        <figure>
          {m.kind === 'vimeo' && (
            <div class="frame">
              <iframe
                src={`https://player.vimeo.com/video/${m.src}?dnt=1&title=0&byline=0&portrait=0`}
                title={m.title ?? 'Vimeo video'}
                loading="lazy"
                allow="autoplay; fullscreen; picture-in-picture"
                allowfullscreen
              />
            </div>
          )}

          {m.kind === 'youtube' && (
            <div class="frame">
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${m.src}?rel=0`}
                title={m.title ?? 'YouTube video'}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; picture-in-picture"
                allowfullscreen
              />
            </div>
          )}

          {m.kind === 'soundcloud' && (
            <iframe
              class="sc-embed"
              src={scUrl(m.src)}
              title={m.title ?? 'SoundCloud player'}
              loading="lazy"
              scrolling="no"
              allow="autoplay"
            />
          )}

          {m.kind === 'bandcamp' && (
            <iframe
              class="bc-embed"
              src={
                `https://bandcamp.com/EmbeddedPlayer/album=${m.src}` +
                `/size=large/bgcol=333333/linkcol=1b3bd4/tracklist=false/artwork=small` +
                (m.track ? `/track=${m.track}` : '') +
                '/transparent=true/'
              }
              title={m.title ?? 'Bandcamp player'}
              loading="lazy"
              seamless
            />
          )}

          {m.kind === 'audio' && (
            <div class="audio">
              <audio controls preload="none" src={m.src} />
            </div>
          )}

          {m.kind === 'image' && (
            <img src={m.src} alt={m.alt ?? m.title ?? ''} loading="lazy" decoding="async" />
          )}

          {(m.title || m.caption) && (
            <figcaption>
              {m.title && <b>{m.title}</b>}
              {m.caption}
            </figcaption>
          )}
        </figure>
      ))}
    </div>
  )
}
