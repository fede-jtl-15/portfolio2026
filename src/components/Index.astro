---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
---

<ul class="index">
  {
    entries.map((entry) => (
      <li class="entry">
        <a class="entry__link" href={`/work/${entry.id}`}>
          <span class="entry__chip" aria-hidden="true" />

          <span class="entry__title">
            {entry.data.title}
            {entry.data.wip && <span class="entry__wip">(wip)</span>}
          </span>

          <span class="entry__meta">
            {(() => {
              const bits = [entry.data.format, entry.data.year].filter(Boolean);
              return bits.length ? `(${bits.join(', ')})` : '';
            })()}
          </span>
        </a>
      </li>
    ))
  }
</ul>
