node_modules/
dist/
.astro/
.DS_Store
*.log
.env
.env.production
r2-credentials.txt
.r2-staging/

# Generated on every build from public/images/** — regenerated fresh by the
# Cloudflare Pages build itself, not needed in git. Currently several GB;
# committing it would bloat every future clone for no benefit. Catches every
# compressed-derivative cache dir (proyectos/cache, home/cache, ...), not
# just the ones that exist today. Named "cache" rather than the earlier
# "strip" on purpose — Cloudflare Pages' deploy-upload step was silently
# dropping every file under any directory literally named "strip" from the
# published output (confirmed: renaming fixed it, page/asset paths outside
# a "strip" dir deployed fine throughout), whatever the exact mechanism.
public/images/**/cache/

# Unused scratch folder of candidate landing-page images (226MB, not read by
# any current page/component — grepped for references, found none). Kept on
# disk, just not worth committing; ask before deleting it outright.
public/images/proyectos/_landing_2/

# Retired/superseded assets (old PSDs, replaced home-page concepts) — not
# referenced by any current page/component. Kept on disk as an archive,
# just not worth committing (407MB).
public/images/ignore/

# Leftover from the deleted /idea-2 draft homepage (idea_landing_2.mp4) and
# an old unused tr33 reference clip (tr33.mp4) — neither is referenced by
# any current page/component. Kept on disk, not worth committing.
public/videos/

# All videos are hosted on Cloudflare R2 instead of git — GitHub hard-blocks
# any single file over 100MB, and this project's source footage regularly
# exceeds that (several 200MB+ reels). See src/lib/r2-media.ts and
# scripts/migrate-videos-to-r2.mjs — run that script after adding a new
# video so it gets uploaded and added to src/data/r2-media.json.
assets/**/*.mp4
assets/**/*.mov
assets/**/*.m4v
assets/**/*.webm
public/images/home/*.mp4
public/images/home/*.mov
public/images/home/*.m4v
public/images/home/*.webm

# Gifs over GIF_COMPRESS_MAX_BYTES (8MB, see src/lib/hub-assets.ts) skip
# local recompression and are hosted on R2 too — effectively a video
# wearing a gif extension. Listed explicitly (not a size-based glob, since
# gitignore can't match by file size) — scripts/migrate-videos-to-r2.mjs
# uses the same 8MB threshold, so re-run it and add the new path here after
# dropping in another gif that large.
assets/audiovisual/eliangel/mi vibe/Mi_vibe_Final_v2.gif
assets/audiovisual/tres_islas/ambar_IG_3_v2.gif
assets/audiovisual/tres_islas/AzaleaCanvas_v1.gif
assets/audiovisual/tres_islas/Caricias_Video_IG_V2.gif
assets/audiovisual/tres_islas/Chapulin_Canvas_V1.gif
assets/audiovisual/tres_islas/PatoBlanco_Canvas_v1.gif
assets/audiovisual/tres_islas/_Lichi_Canvas_1.gif
